{
  "name": "color-lint-tool",
  "version": "0.1.0",
  "description": "CLI tool to detect hard-coded colors in RIB 4.0 codebase",
  "main": "src/index.ts",
  "bin": {
    "color-lint": "tsx ./src/index.ts"
  },
  "scripts": {
    "lint": "tsx src/index.ts",
    "lint:help": "tsx src/index.ts --help",
    "test": "tsx src/index.ts ./test/fixtures"
  },
  "keywords": [
    "lint",
    "color",
    "css",
    "code-quality"
  ],
  "author": "Your Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "glob": "^10.3.10",
    "minimist": "^1.2.8"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.8.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  }
}
