{
  "name": "color-lint-tool",
  "version": "1.0.0",
  "description": "A CLI tool to detect hard-coded CSS color violations",
  "main": "dist/src/cli.js",
  "bin": {
    "color-lint": "./bin/color-lint-check.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:verbose": "vitest run --reporter=verbose",
    "validate": "pwsh -File scripts/validate-tdd.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rutujaPawar-15/color-lint-tool.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rutujaPawar-15/color-lint-tool/issues"
  },
  "homepage": "https://github.com/rutujaPawar-15/color-lint-tool#readme",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.15",
    "postcss-scss": "^4.0.9"
  }
}
