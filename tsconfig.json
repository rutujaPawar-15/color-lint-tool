{
  "compilerOptions": {
    /* Modern Node.js Engine Settings */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Interop & Safety */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    
    /* Turn this off so our 'export' works beautifully in NodeNext */
    "verbatimModuleSyntax": false,
    "sourceMap": true,
    "declaration": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "bin"]
}